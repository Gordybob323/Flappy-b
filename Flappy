<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Flappy Bird</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    body {
      background: #70c5ce;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100dvh;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      overflow: hidden;
    }

    #game-container {
      position: relative;
      width: 100%;
      max-width: 400px;
      height: 100dvh;
      max-height: 700px;
      background: #70c5ce;
      overflow: hidden;
      box-shadow: 0 0 40px rgba(0,0,0,0.3);
    }

    canvas {
      display: block;
      width: 100%;
      height: 100%;
    }

    #ui {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    #score {
      position: absolute;
      top: 40px;
      font-size: 48px;
      font-weight: 800;
      color: white;
      text-shadow: 3px 3px 0 #000, -2px -2px 0 #000, 2px -2px 0 #000, -2px 2px 0 #000;
      z-index: 10;
    }

    #start-screen, #game-over {
      background: rgba(0,0,0,0.55);
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: white;
      text-align: center;
      pointer-events: auto;
    }

    #game-over {
      display: none;
    }

    h1 {
      font-size: 42px;
      margin-bottom: 10px;
      text-shadow: 3px 3px 0 #000;
    }

    p {
      font-size: 18px;
      margin-bottom: 25px;
      opacity: 0.9;
    }

    .btn {
      background: #f7c531;
      color: #333;
      border: none;
      padding: 14px 36px;
      font-size: 20px;
      font-weight: 700;
      border-radius: 12px;
      cursor: pointer;
      box-shadow: 0 6px 0 #c9a012;
      transition: transform 0.1s;
    }

    .btn:active {
      transform: translateY(4px);
      box-shadow: 0 2px 0 #c9a012;
    }

    #final-score {
      font-size: 28px;
      margin: 15px 0 25px;
      font-weight: 700;
    }
  </style>
</head>
<body>
  <div id="game-container">
    <canvas id="game"></canvas>

    <div id="ui">
      <div id="score">0</div>

      <div id="start-screen">
        <h1>Flappy Bird</h1>
        <p>Tap or press Space to flap</p>
        <button class="btn" id="start-btn">Start</button>
      </div>

      <div id="game-over">
        <h1>Game Over</h1>
        <div id="final-score">Score: 0</div>
        <button class="btn" id="restart-btn">Play Again</button>
      </div>
    </div>
  </div>

  <script>
    const canvas = document.getElementById('game');
    const ctx = canvas.getContext('2d');
    const scoreEl = document.getElementById('score');
    const startScreen = document.getElementById('start-screen');
    const gameOverScreen = document.getElementById('game-over');
    const finalScoreEl = document.getElementById('final-score');
    const startBtn = document.getElementById('start-btn');
    const restartBtn = document.getElementById('restart-btn');

    // Resize canvas
    function resize() {
      const container = document.getElementById('game-container');
      canvas.width = container.clientWidth;
      canvas.height = container.clientHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    // Game variables
    let bird, pipes, score, frames, gameState; // 'start', 'playing', 'over'
    const gravity = 0.45;
    const jump = -8.2;
    const pipeGap = 155;
    const pipeWidth = 65;
    const pipeSpeed = 2.8;

    function init() {
      bird = {
        x: canvas.width * 0.25,
        y: canvas.height / 2,
        width: 34,
        height: 24,
        velocity: 0,
        rotation: 0
      };
      pipes = [];
      score = 0;
      frames = 0;
      gameState = 'start';
      scoreEl.textContent = '0';
      startScreen.style.display = 'flex';
      gameOverScreen.style.display = 'none';
    }

    function createPipe() {
      const minHeight = 60;
      const maxHeight = canvas.height - pipeGap - minHeight - 80;
      const height = Math.floor(Math.random() * (maxHeight - minHeight + 1)) + minHeight;

      pipes.push({
        x: canvas.width,
        top: height,
        bottom: height + pipeGap,
        scored: false
      });
    }

    function flap() {
      if (gameState === 'playing') {
        bird.velocity = jump;
      } else if (gameState === 'start') {
        startGame();
      } else if (gameState === 'over') {
        init();
        startGame();
      }
    }

    function startGame() {
      gameState = 'playing';
      startScreen.style.display = 'none';
      gameOverScreen.style.display = 'none';
    }

    function gameOver() {
      gameState = 'over';
      finalScoreEl.textContent = `Score: ${score}`;
      gameOverScreen.style.display = 'flex';
    }

    // Input
    canvas.addEventListener('click', flap);
    canvas.addEventListener('touchstart', (e) => {
      e.preventDefault();
      flap();
    });
    document.addEventListener('keydown', (e) => {
      if (e.code === 'Space' || e.code === 'ArrowUp') {
        e.preventDefault();
        flap();
      }
    });
    startBtn.addEventListener('click', startGame);
    restartBtn.addEventListener('click', () => {
      init();
      startGame();
    });

    // Draw functions
    function drawBackground() {
      // Sky
      ctx.fillStyle = '#70c5ce';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Ground
      ctx.fillStyle = '#ded895';
      ctx.fillRect(0, canvas.height - 80, canvas.width, 80);

      // Grass
      ctx.fillStyle = '#73bf2e';
      ctx.fillRect(0, canvas.height - 80, canvas.width, 18);
    }

    function drawBird() {
      ctx.save();
      ctx.translate(bird.x + bird.width / 2, bird.y + bird.height / 2);
      ctx.rotate(bird.rotation);

      // Body
      ctx.fillStyle = '#f7c531';
      ctx.beginPath();
      ctx.ellipse(0, 0, bird.width / 2, bird.height / 2, 0, 0, Math.PI * 2);
      ctx.fill();

      // Wing
      ctx.fillStyle = '#e8a317';
      ctx.beginPath();
      ctx.ellipse(-4, 2, 10, 7, -0.3, 0, Math.PI * 2);
      ctx.fill();

      // Eye
      ctx.fillStyle = 'white';
      ctx.beginPath();
      ctx.arc(8, -4, 6, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = 'black';
      ctx.beginPath();
      ctx.arc(10, -4, 3, 0, Math.PI * 2);
      ctx.fill();

      // Beak
      ctx.fillStyle = '#e74c3c';
      ctx.beginPath();
      ctx.moveTo(12, 2);
      ctx.lineTo(22, 5);
      ctx.lineTo(12, 9);
      ctx.closePath();
      ctx.fill();

      ctx.restore();
    }

    function drawPipes() {
      pipes.forEach(pipe => {
        // Top pipe
        ctx.fillStyle = '#73bf2e';
        ctx.fillRect(pipe.x, 0, pipeWidth, pipe.top);
        ctx.fillStyle = '#558b2f';
        ctx.fillRect(pipe.x - 3, pipe.top - 25, pipeWidth + 6, 25);

        // Bottom pipe
        ctx.fillStyle = '#73bf2e';
        ctx.fillRect(pipe.x, pipe.bottom, pipeWidth, canvas.height - pipe.bottom - 80);
        ctx.fillStyle = '#558b2f';
        ctx.fillRect(pipe.x - 3, pipe.bottom, pipeWidth + 6, 25);
      });
    }

    function update() {
      if (gameState !== 'playing') return;

      frames++;

      // Bird physics
      bird.velocity += gravity;
      bird.y += bird.velocity;

      // Rotation based on velocity
      bird.rotation = Math.min(Math.PI / 4, Math.max(-Math.PI / 6, bird.velocity * 0.08));

      // Create pipes
      if (frames % 100 === 0) {
        createPipe();
      }

      // Move pipes
      for (let i = pipes.length - 1; i >= 0; i--) {
        pipes[i].x -= pipeSpeed;

        // Score
        if (!pipes[i].scored && pipes[i].x + pipeWidth < bird.x) {
          pipes[i].scored = true;
          score++;
          scoreEl.textContent = score;
        }

        // Remove off-screen pipes
        if (pipes[i].x + pipeWidth < 0) {
          pipes.splice(i, 1);
        }
      }

      // Collision detection
      // Ground / ceiling
      if (bird.y + bird.height >= canvas.height - 80 || bird.y <= 0) {
        gameOver();
        return;
      }

      // Pipes
      for (const pipe of pipes) {
        if (
          bird.x < pipe.x + pipeWidth &&
          bird.x + bird.width > pipe.x &&
          (bird.y < pipe.top || bird.y + bird.height > pipe.bottom)
        ) {
          gameOver();
          return;
        }
      }
    }

    function draw() {
      drawBackground();
      drawPipes();
      drawBird();
    }

    function loop() {
      update();
      draw();
      requestAnimationFrame(loop);
    }

    // Start
    init();
    loop();
  </script>
</body>
</html>
